# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (shared with the CodeIgniter PHP app) ──────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexam
DB_CONNECTION_LIMIT=10

# ── Auth (JWT) ──────────────────────────────────────────
# Generate a long random string for production: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# PHP web app + Flutter ( capacitor / web view ) + dev tools.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,capacitor://localhost,http://localhost

# ── Web app URL ─────────────────────────────────────────
# Public URL of the React web app — used to build links in emails.
WEB_URL=http://localhost:5173

# ── SMTP (email) ────────────────────────────────────────
# Same env vars as the PHP app. NEXAM_SMTP_PASS must be set for OTP delivery.
NEXAM_SMTP_HOST=mail.mati.gov.ph
NEXAM_SMTP_PORT=587
NEXAM_SMTP_USER=nexam@mati.gov.ph
NEXAM_SMTP_PASS=
NEXAM_SMTP_CRYPTO=tls

# ── Vector Store (HNSWLib) ───────────────────────────────
# Directory where the HNSWLib vector index persists to disk.
# This is the dedicated vector database — embeddings live here, not in MySQL.
# One subdirectory is created per subject (chunks/<id> and questions/<id>).
VECTOR_STORE_DIR=storage/vectors

# ── AI Providers (free tiers) ───────────────────────────
# Primary: Google Gemini (generation + embeddings)
# Fallback: Groq (generation only; no embeddings)
# Get keys at:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── AI Worker ───────────────────────────────────────────
# Polling interval (ms) for the async job queue.
WORKER_POLL_INTERVAL=5000
WORKER_CONCURRENCY=2
# Max tokens for generation responses.
AI_MAX_TOKENS=8192
# Generation temperature (0 = deterministic, 1 = creative).
AI_TEMPERATURE=0.4
