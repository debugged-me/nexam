# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (shared with the CodeIgniter PHP app) ──────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nexam
DB_CONNECTION_LIMIT=10

# ── Auth (JWT) ──────────────────────────────────────────
# Generate a long random string for production: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# PHP web app + Flutter ( capacitor / web view ) + dev tools.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,capacitor://localhost,http://localhost

# ── AI Providers (free tiers) ───────────────────────────
# Primary: Google Gemini (generation + embeddings)
# Fallback: Groq (generation only; no embeddings)
# Get keys at:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── AI Worker ───────────────────────────────────────────
# Polling interval (ms) for the async job queue.
WORKER_POLL_INTERVAL=5000
WORKER_CONCURRENCY=2
# Max tokens for generation responses.
AI_MAX_TOKENS=8192
# Generation temperature (0 = deterministic, 1 = creative).
AI_TEMPERATURE=0.4
