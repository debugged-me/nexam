{
  "name": "nexam-api",
  "version": "1.0.0",
  "description": "Node.js API backend for nexam — RAG pipeline (LangChain + HNSWLib vector store + Gemini), exam generation, OMR scanning, and LMS export. Serves the web frontend and the Flutter mobile app.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test 'test/*.test.js'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "hnswlib-node": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "mysql2": "^3.24.3",
    "nodemailer": "^10.0.9",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^25.10.0",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "youtube-transcript": "^1.3.1"
